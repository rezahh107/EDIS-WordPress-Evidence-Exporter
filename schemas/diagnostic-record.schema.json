{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edis:schema:diagnostic-record:1.0.0",
  "title": "EDIS Canonical LLM Diagnostic Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "diagnostic_identity",
    "completeness_boundary",
    "system_identity",
    "operation_identity",
    "failure_location",
    "failure_classification",
    "recorded_facts",
    "plugin_classification",
    "causal_timeline",
    "expected_vs_observed",
    "evidence_and_provenance",
    "safe_context",
    "unresolved_questions",
    "recovery_guidance",
    "supporting_artifact_index",
    "bounds",
    "model_usage",
    "model_analysis_not_included"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema_id", "schema_version", "media_type"],
      "properties": {
        "format": {"const": "EDIS-DIAGNOSTIC-1"},
        "schema_id": {"const": "urn:edis:schema:diagnostic-record:1.0.0"},
        "schema_version": {"const": "1.0.0"},
        "media_type": {"const": "application/vnd.edis.diagnostic+json"}
      }
    },
    "diagnostic_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_id", "record_type", "created_at", "expires_at"],
      "properties": {
        "diagnostic_id": {"type": "string", "pattern": "^edis-diag-[a-f0-9]{32}$", "maxLength": 42},
        "record_type": {"type": "string", "enum": ["PRE_JOB_FAILURE", "JOB_FAILURE", "WORKER_FAILURE", "DEGRADED_FAILURE", "BOOT_FAILURE"]},
        "created_at": {"type": "string", "format": "date-time", "maxLength": 40},
        "expires_at": {"type": "string", "format": "date-time", "maxLength": 40}
      }
    },
    "completeness_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "excluded_evidence"],
      "properties": {
        "status": {"$ref": "#/$defs/evidence_status"},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "excluded_evidence": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "system_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_version", "worker_implementation_version", "wordpress_version", "php_version", "elementor_version", "build_identity"],
      "properties": {
        "plugin_version": {"$ref": "#/$defs/observation"},
        "worker_implementation_version": {"$ref": "#/$defs/observation"},
        "wordpress_version": {"$ref": "#/$defs/observation"},
        "php_version": {"$ref": "#/$defs/observation"},
        "elementor_version": {"$ref": "#/$defs/observation"},
        "build_identity": {"$ref": "#/$defs/observation"}
      }
    },
    "operation_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_type", "rest_route", "job_id", "export_scope", "privacy_mode", "selected_components", "selected_document_count"],
      "properties": {
        "operation_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "rest_route": {"type": ["string", "null"], "maxLength": 256},
        "job_id": {"type": ["string", "null"], "maxLength": 64},
        "export_scope": {"type": ["string", "null"], "maxLength": 64},
        "privacy_mode": {"type": ["string", "null"], "maxLength": 32},
        "selected_components": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}},
        "selected_document_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 250}
      }
    },
    "failure_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_stage", "subsystem", "operation_immediately_attempted", "last_successful_state", "failure_boundary"],
      "properties": {
        "lifecycle_stage": {"type": ["string", "null"], "maxLength": 128},
        "subsystem": {"type": ["string", "null"], "maxLength": 128},
        "operation_immediately_attempted": {"type": "string", "minLength": 1, "maxLength": 256},
        "last_successful_state": {"type": ["string", "null"], "maxLength": 128},
        "failure_boundary": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "failure_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_code", "internal_code", "exception_class", "scope", "retryability", "terminal_state", "root_cause", "root_cause_status"],
      "properties": {
        "public_code": {"type": ["string", "null"], "maxLength": 128},
        "internal_code": {"type": ["string", "null"], "maxLength": 128},
        "exception_class": {"type": ["string", "null"], "maxLength": 256},
        "scope": {"type": "string", "enum": ["SEMANTIC", "OPERATIONAL", "UNKNOWN"]},
        "retryability": {"type": "string", "enum": ["RETRY_SAFE", "RESUME_SAFE", "NEW_JOB_REQUIRED", "REPAIR_REQUIRED", "NOT_RETRYABLE", "NOT_PROVEN"]},
        "terminal_state": {"type": "string", "enum": ["IN_PROGRESS", "FAILED", "CANCELLED", "COMPLETED", "UNKNOWN"]},
        "root_cause": {"type": "null"},
        "root_cause_status": {"const": "NOT_PROVEN"}
      }
    },
    "recorded_facts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/fact"}},
    "plugin_classification": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/classification"}},
    "causal_timeline": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/timeline_event"}},
    "expected_vs_observed": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/expected_observed"}},
    "evidence_and_provenance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
    "safe_context": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"type": ["string", "integer", "boolean", "null"], "maxLength": 256}
    },
    "unresolved_questions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/question"}},
    "recovery_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_immediate_action", "retry_action", "resume_action", "new_job_action", "developer_investigation", "stop_conditions"],
      "properties": {
        "safe_immediate_action": {"type": "string", "minLength": 1, "maxLength": 512},
        "retry_action": {"type": "string", "maxLength": 128},
        "resume_action": {"type": "string", "maxLength": 128},
        "new_job_action": {"type": "string", "maxLength": 128},
        "developer_investigation": {"type": "string", "maxLength": 256},
        "stop_conditions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 256}}
      }
    },
    "supporting_artifact_index": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/supporting_artifact"}},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_payload_bytes", "truncated", "truncated_fields"],
      "properties": {
        "maximum_payload_bytes": {"const": 65536},
        "truncated": {"type": "boolean"},
        "truncated_fields": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/truncation"}}
      }
    },
    "model_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_policy", "classification_policy", "unknown_policy", "next_action_policy"],
      "properties": {
        "fact_policy": {"type": "string", "maxLength": 256},
        "classification_policy": {"type": "string", "maxLength": 256},
        "unknown_policy": {"type": "string", "maxLength": 256},
        "next_action_policy": {"type": "string", "maxLength": 256}
      }
    },
    "model_analysis_not_included": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause_analysis", "repair_claim", "reason"],
      "properties": {
        "root_cause_analysis": {"const": false},
        "repair_claim": {"const": false},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "evidence_status": {"type": "string", "enum": ["CONFIRMED", "DERIVED", "NOT_PROVEN", "UNAVAILABLE", "CONTRADICTED"]},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "evidence_ids"],
      "properties": {
        "value": {"type": ["string", "integer", "boolean", "null"], "maxLength": 256},
        "status": {"$ref": "#/$defs/evidence_status"},
        "evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "statement", "status", "evidence_ids"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^fact-[0-9]{3}$", "maxLength": 16},
        "statement": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"const": "CONFIRMED"},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_id", "rule_id", "rule_version", "classification", "status", "input_fact_ids"],
      "properties": {
        "classification_id": {"type": "string", "pattern": "^class-[0-9]{3}$", "maxLength": 16},
        "rule_id": {"type": "string", "maxLength": 128},
        "rule_version": {"type": "string", "maxLength": 32},
        "classification": {"type": "string", "maxLength": 512},
        "status": {"const": "DERIVED"},
        "input_fact_ids": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 16}}
      }
    },
    "timeline_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "observed_at", "event_type", "before_state", "after_state", "operation", "status", "evidence_ids"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
        "observed_at": {"type": ["string", "null"], "maxLength": 40},
        "event_type": {"type": "string", "maxLength": 128},
        "before_state": {"type": ["string", "null"], "maxLength": 128},
        "after_state": {"type": ["string", "null"], "maxLength": 128},
        "operation": {"type": "string", "maxLength": 128},
        "status": {"$ref": "#/$defs/evidence_status"},
        "evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "expected_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "expected", "observed", "mismatch", "status", "evidence_ids"],
      "properties": {
        "invariant_id": {"type": "string", "maxLength": 128},
        "expected": {"type": "string", "maxLength": 512},
        "observed": {"type": "string", "maxLength": 512},
        "mismatch": {"type": "boolean"},
        "status": {"$ref": "#/$defs/evidence_status"},
        "evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "source_locator", "status"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev-[0-9]{3}$", "maxLength": 16},
        "source_type": {"type": "string", "maxLength": 128},
        "source_locator": {"type": "string", "maxLength": 256},
        "status": {"$ref": "#/$defs/evidence_status"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "status", "why_it_matters", "smallest_collection_action"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^missing-[0-9]{3}$", "maxLength": 20},
        "question": {"type": "string", "maxLength": 256},
        "status": {"type": "string", "enum": ["NOT_PROVEN", "UNAVAILABLE", "CONTRADICTED"]},
        "why_it_matters": {"type": "string", "maxLength": 512},
        "smallest_collection_action": {"type": "string", "maxLength": 512}
      }
    },
    "supporting_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "type", "media_type", "sha256", "size", "purpose", "inclusion_reason", "availability"],
      "properties": {
        "artifact_id": {"type": "string", "maxLength": 128},
        "type": {"type": "string", "maxLength": 128},
        "media_type": {"type": "string", "maxLength": 128},
        "sha256": {"type": ["string", "null"], "maxLength": 80},
        "size": {"type": ["integer", "null"], "minimum": 0, "maximum": 67108864},
        "purpose": {"type": "string", "maxLength": 256},
        "inclusion_reason": {"type": "string", "maxLength": 256},
        "availability": {"type": "string", "enum": ["AVAILABLE", "UNAVAILABLE", "EXPIRED"]}
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "original_count", "retained_count"],
      "properties": {
        "path": {"type": "string", "maxLength": 256},
        "original_count": {"type": "integer", "minimum": 0},
        "retained_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
