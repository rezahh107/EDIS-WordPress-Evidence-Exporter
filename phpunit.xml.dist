<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="autoload.php" colors="true" failOnEmptyTestSuite="true">
  <php>
    <const name="ABSPATH" value="/tmp/wordpress/"/>
  </php>
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">tests/Unit</directory>
    </testsuite>
  </testsuites>
</phpunit>
